{
  "manifest_version": 3,
  "name": "Dear Editor · 查询助手",
  "description": "读取 Elsevier 投稿进展和 Scopus 引用指标，并返回发起查询的 Dear Editor 标签页。",
  "version": "4.3.1",
  "permissions": ["scripting"],
  "host_permissions": ["http://127.0.0.1/*", "https://huaisong-yang.github.io/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {
      "matches": ["https://webapps.elsevier.cn/st-wechat/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.scopus.com/authid/*", "https://www.scopus.com/pages/author/*",
        "https://scopus.com/authid/*", "https://scopus.com/pages/author/*"],
      "js": ["citation-reader.js"],
      "run_at": "document_start"
    }
  ]
}
